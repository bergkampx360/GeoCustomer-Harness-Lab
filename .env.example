# Postgres, used by docker-compose and (from Milestone 5 onward) Prisma.
POSTGRES_USER=geocustomer
POSTGRES_PASSWORD=geocustomer
POSTGRES_DB=geocustomer
POSTGRES_PORT=5432

# Full connection string, must match the POSTGRES_* values and port above.
DATABASE_URL=postgresql://geocustomer:geocustomer@localhost:5432/geocustomer
