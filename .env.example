# Copy this file to .env and adjust if needed. Never commit the real .env file.

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=geocustomer
POSTGRES_PORT=5432

# Assembled from the same values above; used by Prisma in later stories.
# NOTE: DATABASE_URL is not derived automatically — if you change POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB, or POSTGRES_PORT above, update this line to match.
DATABASE_URL=postgresql://changeme:changeme@localhost:5432/geocustomer
